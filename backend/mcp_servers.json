{
  "mcpServers": {
    "local": {
      "command": "python",
      "args": ["-m", "app.services.agent.mcp.local_server"],
      "enabled": true,
      "description": "本地工具 - execute_command, read_log, memory"
    },
    "robot": {
      "command": "python",
      "args": ["-m", "app.services.agent.mcp.robot_server"],
      "enabled": false,
      "description": "QQ 接入消息工具 - 仅在机器人会话需要时动态启用"
    }
  }
}
