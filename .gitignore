.vscode/*
!.vscode/extensions.json
__pycache__/
.runtime/
.env
**/.env
**/.env.*
!**/.env.example
!**/.env-example
daemon/log/
backend/app/services/log/
backend/sql_app.db
/sql_app.db
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/workdir/*
!/workdir/.gitkeep
/daemon/workdir/*
!/daemon/workdir/.gitkeep

# local temp files (may contain tokens)
/_token.txt
/_apply_patch.txt

# packaging build artifacts
/dist/
/backend/dist/
/packaging/*/dist/

# debug scratch
/de_bug/

# daemon runtime dirs (recreated at runtime)
/daemon/src/workdir/
/daemon/src/log/
/daemon/src/data/
/daemon/src/src/
