FROM mcr.microsoft.com/playwright:v1.58.2-noble

ARG USE_CHINA_MIRRORS=true

WORKDIR /app

# Install base packages needed by the test image.
RUN if [ "$USE_CHINA_MIRRORS" = "true" ] && [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i \
            -e 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            -e 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            -e 's|https://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            -e 's|https://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            /etc/apt/sources.list.d/ubuntu.sources; \
    elif [ "$USE_CHINA_MIRRORS" = "true" ] && [ -f /etc/apt/sources.list ]; then \
        sed -i \
            -e 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            -e 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            -e 's|https://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            -e 's|https://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
            /etc/apt/sources.list; \
    fi \
    && apt-get update && apt-get install -y \
    unzip \
    ca-certificates \
    openssl \
    curl \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

RUN if [ "$USE_CHINA_MIRRORS" = "true" ]; then \
        npm config set registry https://registry.npmmirror.com; \
    fi \
    && npm install -g bun@1 \
    && ln -sf "$(command -v bun)" /usr/local/bin/bunx \
    && bun --version

COPY package.json bun.lock /app/
COPY frontend/package.json /app/frontend/

WORKDIR /app/frontend

RUN if [ "$USE_CHINA_MIRRORS" = "true" ]; then \
        bun install --registry https://registry.npmmirror.com; \
    else \
        sed -i 's|https://registry.npmmirror.com|https://registry.npmjs.org|g' /app/bun.lock \
        && bun install; \
    fi

COPY ./frontend /app/frontend

ARG VITE_API_URL
