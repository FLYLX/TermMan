                  {/* Terminal Body */}
                  <ScrollArea className="h-[500px] p-4">
                    <div className="font-mono text-sm space-y-1">
                      <div className="text-green-400">$ Welcome to {item.title} terminal</div>
                      <div className="text-gray-400">$ This is a simulated terminal interface</div>
                      <div className="text-gray-400">$ The terminal functionality is not yet implemented</div>
                      <div className="text-gray-400">$ Use the buttons on the left to control the daemon</div>
                      <div className="text-gray-400"></div>
                      <div className="text-gray-400">$ ls -la</div>
                      <div className="text-gray-300">total 20</div>
                      <div className="text-gray-300">drwxr-xr-x  5 user  staff   160 Mar  8 10:00 .</div>
                      <div className="text-gray-300">drwxr-xr-x  3 user  staff    96 Mar  8 09:00 ..</div>
                      <div className="text-gray-300">-rw-r--r--  1 user  staff   512 Mar  8 10:00 config.json</div>
                      <div className="text-gray-300">-rwxr-xr-x  1 user  staff  2048 Mar  8 09:30 daemon.exe</div>
                      <div className="text-gray-300">-rw-r--r--  1 user  staff  1024 Mar  8 09:45 log.txt</div>
                      <div className="text-gray-400"></div>
                      <div className="flex items-center">
                        <span className="text-green-400">$</span>
