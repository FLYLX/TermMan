                  <h3 className="text-lg font-semibold">Information</h3>
                  <p className="text-muted-foreground">Detailed information about the item will be displayed here.</p>
                </div>
              </TabsContent>
            </Tabs>
          </CardContent>
        </Card>
      </div>
    </div>
  )
}

function ItemDetail() {
  return (
    <Suspense fallback={<PendingItems />}>
      <ItemContent />
    </Suspense>
  )
}

export const Route = createFileRoute("/_layout/items/id/")({
  component: ItemDetail,
  head: () => ({
    meta: [
      {
        title: "Item Detail - FastAPI Template",
      },
    ],
  }),
})
