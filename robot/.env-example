# TermMan Robot Bridge
ENVIRONMENT=local

# TermMan backend URL reachable from the robot-bridge container.
ROBOT_BACKEND_URL=http://backend:8000

# Base URL used to show the NapCat reverse WebSocket endpoint.
# Set it to the address NapCat can reach.
ROBOT_BRIDGE_URL=http://robot-bridge:8090

# Must match backend ROBOT_BRIDGE_SHARED_SECRET.
# If backend does not set ROBOT_BRIDGE_SHARED_SECRET, it falls back to SECRET_KEY.
ROBOT_BRIDGE_SHARED_SECRET=changethis

ROBOT_BRIDGE_HOST=0.0.0.0
ROBOT_BRIDGE_PORT=8090
ROBOT_QQ_IS_SANDBOX=true
